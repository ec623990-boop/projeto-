DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=biblioteca_vendas
DB_USER=root
DB_PASS=

# Simulação local, sem conexão com provedor e sem cobrança real.
PAYMENT_MODE=simulado_local

# Para integrar opcionalmente o sandbox externo do Mercado Pago, troque o modo
# para mercadopago_test e preencha as duas credenciais de teste abaixo.
# PAYMENT_MODE=mercadopago_test
MP_TEST_PUBLIC_KEY=
MP_TEST_ACCESS_TOKEN=
MP_TEST_WEBHOOK_SECRET=

# Integração opcional do pedido aprovado com o adaptador Java do Senior X.
# Gere uma chave aleatória local e use o mesmo valor no PHP e no serviço Java.
SENIOR_SYNC_ENABLED=false
SENIOR_BRIDGE_URL=http://127.0.0.1:8091/api/orders
SENIOR_BRIDGE_API_KEY=
SENIOR_INTEGRATION_ENABLED=false
SENIOR_API_BASE_URL=https://platform.senior.com.br/t/senior.com.br/bridge/1.0/rest/erpx
SENIOR_AUTH_URL=https://platform.senior.com.br/t/senior.com.br/bridge/1.0/anonymous/rest/platform/authentication/actions/loginWithKey
SENIOR_TENANT_NAME=
SENIOR_ACCESS_KEY=
SENIOR_SECRET=
SENIOR_CLIENT_ID=
SENIOR_COMPANY_ID=
